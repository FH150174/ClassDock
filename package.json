{
  "name": "classdock",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tauri": "tauri",
    "check": "npm run lint && npm run test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src vite.config.ts eslint.config.js *.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "papaparse": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/luxon": "^3.7.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
